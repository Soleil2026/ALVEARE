# Exemple — copier vers infra/.env (généré par infra/mk-dotenv.sh),
# ne JAMAIS committer les valeurs réelles.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<admin-dev>
ALV_ADMIN_PASS=<généré>
ALV_USER_PASS=<généré>
# E3 audit : secret du client e2e (posé sur le client par seed-dev.sh,
# jamais dans le realm JSON versionné) + plafond de tentatives du
# drain (quarantaine audit.outbox_deadletter, défaut 5).
AUDIT_E2E_SECRET=<généré>
AUDIT_ATTEMPTS_CAP=5
# E6 paiements : provider de l'adapter (dev = simulation locale, zéro
# réseau | chargily = PSP sandbox) + plafonds du webhook sortant.
PAYMENTS_PROVIDER=dev
PAYMENTS_HTTP_TIMEOUT_MS=10000
PAYMENTS_WEBHOOK_ATTEMPTS_CAP=5
PAYMENTS_WEBHOOK_MAX_SKEW=300
PAYMENTS_TTL_SECONDS=1200
# Secret sandbox Chargily Pay v2 (compte opérateur) — requis UNIQUEMENT
# si PAYMENTS_PROVIDER=chargily ; jamais généré, jamais committé.
CHARGILY_SECRET_KEY=<secret sandbox de l'opérateur>

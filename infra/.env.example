# Exemple — copier vers infra/.env (généré par infra/mk-dotenv.sh),
# ne JAMAIS committer les valeurs réelles.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<admin-dev>
ALV_ADMIN_PASS=<généré>
ALV_USER_PASS=<généré>
# E3 audit : secret du client e2e (posé sur le client par seed-dev.sh,
# jamais dans le realm JSON versionné) + plafond de tentatives du
# drain (quarantaine audit.outbox_deadletter, défaut 5).
AUDIT_E2E_SECRET=<généré>
AUDIT_ATTEMPTS_CAP=5

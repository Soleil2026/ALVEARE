// Prisma — BD du socle ALVEARE Core (V1).
// - Schéma 'identity' : rôles par application + consentements de partage.
//   L'audit est dans le schéma 'audit' (SQL brut, voir
//   infra/postgres-init.sh) et est accédé via $queryRaw — décision
//   assumée (plan E2 T2.6).
// - Schéma 'documents' (E4) : fichiers + jetons de partage signés.
// - Schéma 'notify' (E5) : messages de notification — adresse
//   destinataire chiffrée au repos (JWE, clé NOTIFY_DATA_KEY env),
//   indexée par hash ; jamais en clair côté log ou exposition API.

generator client {
  provider = "prisma-client-js"
  schemas  = ["identity", "documents", "notify"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "documents", "notify"]
}

/// Attribution d'un rôle DANS une application B2B (doc B §2.4) :
/// un compte global ne donne aucun accès automatique — chaque app
/// accorde (ou révoque) le rôle de l'utilisateur chez elle.
model RoleGrant {
  id        Int      @id @default(autoincrement())
  userId    String   // subject (sub) Keycloak
  /// app branchée : "core-admin", "app-01".."app-12"
  app       String
  /// UserRoleSchema : "admin" | "gestionnaire" | "utilisateur"
  role      String
  createdAt DateTime @default(now())
  createdBy String

  @@unique([userId, app])
  @@index([app, role])
  @@schema("identity")
}

/// Registre des consentements de partage (FR-02.5, B §4.3) :
/// l'utilisateur autorise une app consommatrice sur un périmètre,
/// révocable à tout moment, tracé.
model Consent {
  id            Int       @id @default(autoincrement())
  userId        String
  /// app consommatrice
  consumingApp  String
  /// périmètre consent (ex. "documents:read", "identity:profile")
  scope         String
  grantedAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@unique([userId, consumingApp, scope])
  @@index([userId, revokedAt])
  @@schema("identity")
}

/// Fichier document d'un utilisateur (FR-04.x) — V1 = 1 version.
/// Contenu binaire sur disque local (DATA_DIR), jamais en git.
model Document {
  id        BigInt   @id @default(autoincrement())
  /// propriétaire = subject Keycloak (B §2.4)
  ownerSub  String
  /// nom d'origine nettoyé (sans arborescence)
  fileName  String
  mimeType  String
  sizeBytes Int
  sha256    String
  /// chemin relatif sous DATA_DIR
  storedPath String
  createdAt DateTime @default(now())
  shares    ShareToken[]

  @@index([ownerSub, createdAt])
  @@schema("documents")
}

/// Jetons d'URL temporaire signée (B §4.6) — révocables à la demande.
/// Le secret HMAC reste dans .env (jamais en BD ni en code).
model ShareToken {
  id        BigInt    @id @default(autoincrement())
  /// id unique du token (jti JWT)
  jti       String    @unique
  document  Document  @relation(fields: [documentId], references: [id])
  documentId BigInt
  createdBy String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([documentId, revokedAt])
  @@schema("documents")
}

/// Message de notification (FR-05.1) — V1 email + SMS adaptateur local.
/// Minimisation (zone Red) : l'adresse (email/téléphone) n'est JAMAIS
/// stockée en clair — chiffrement JWE (NOTIFY_DATA_KEY) + hash pour
/// l'indexation. `via` = app émettrice, tracée (audit minimal).
model Notification {
  id              BigInt    @id @default(autoincrement())
  /// "email" | "sms"
  channel         String
  /// template whitelisté : "verify-email" | "password-reset" |
  /// "document-shared" | "test"
  template        String
  /// "fr" | "ar" | "en"
  lang            String
  /// hash (HMAC-SHA256 tronqué 16 octets) de l'adresse normalisée
  recipientHash   String
  /// adresse chiffrée JWE A256GCM (email ou E.164)
  recipientCipher String
  /// app émettrice ("identity", "documents", ...)
  via             String
  /// "queued" | "sent" | "failed"
  status          String
  /// raison d'échec (sans adresse — jamais d'erreur brute exposant PII)
  error           String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  /// anti-double envoi (idempotence de l'émetteur)
  dedupKey        String?   @unique

  @@index([recipientHash, createdAt])
  @@schema("notify")
}
